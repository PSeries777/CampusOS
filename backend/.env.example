NODE_ENV=development
PORT=8080
# The default is loopback. Set an explicit address only if external access is needed.
# HOST=127.0.0.1

DATABASE_PATH=./data/sms.sqlite
# Dedicated private local directory. Keep the database outside it.
UPLOAD_DIR=./uploads
# Limits apply per backend process.
# DOCUMENT_UPLOAD_CONCURRENCY=2
# DOCUMENT_UPLOAD_TIMEOUT_MS=120000
# DOCUMENT_ARCHIVE_MAX_ENTRIES=1000

# Required in every environment. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

LOG_LEVEL=info
